MAC OS:

brew install libpng

Check number of CPUs:

Binita-Bharatis-MacBook-Air-M4:input binita$ sysctl -n hw.ncpu
10
Binita-Bharatis-MacBook-Air-M4:input binita$ sysctl -n hw.physicalcpu
10
Binita-Bharatis-MacBook-Air-M4:input binita$ sysctl -n hw.logicalcpu
10

Now compile:

gcc -O3 -pthread src/gray.c -o bin/gray \
    -I/opt/homebrew/include \
    -L/opt/homebrew/lib \
    -lpng


gcc -O3 -pthread src/bilateral.c -o bin/bilateral \
    -I/opt/homebrew/include \
    -L/opt/homebrew/lib \
    -lpng -lm

    ===============================
Edge detection:

Mac :
brew install jpeg-turbo

gcc -O3 src/edge_detect.c -o edge_detect \
-I$(brew --prefix jpeg-turbo)/include \
-L$(brew --prefix jpeg-turbo)/lib \
-ljpeg

Debian:
sudo apt update;sudo apt install gcc libjpeg-dev

gcc -O3 src/edge_detect.c -o edge_detect -ljpeg

==============================

mp4 handling:

brew install pkg-config

pkg-config --cflags --libs libavformat libavcodec libavutil

-I/opt/homebrew/Cellar/ffmpeg/9.0.1_1/include -I/opt/homebrew/include -I/opt/homebrew/include/SDL2 -D_THREAD_SAFE -L/opt/homebrew/Cellar/ffmpeg/9.0.1_1/lib -lavformat -lavcodec -lavutil -L/opt/homebrew/lib -lSDL2main -lSDL2 -Wl,-framework,Cocoa

gcc -O3 src/video_sobel.c -o video_sobel \
    $(pkg-config --cflags --libs libavformat libavcodec libavutil sdl2) \
    -lm

gcc -O3 src/video_sobel.c -o video_sobel \
    $(pkg-config --cflags --libs libavformat libavcodec libavutil) \
    -lm

./video_sobel resources/input/mp4/4k/1.mp4  output_sobel.mp4

Debian:
sudo apt install ffmpeg pkg-config \
    libavformat-dev libavcodec-dev libavutil-dev

gcc -O3 video_sobel.c -o video_sobel \
    $(pkg-config --cflags --libs libavformat libavcodec libavutil) \
    -lm

gcc -O3 src/sobel/video_sobel_sequential.c -o video_sobel_seq $(pkg-config --cflags --libs libavformat libavcodec libavutil)  -lm

./video_sobel_seq resources/input/mp4/4k/1.mp4 sobel_seq.mp4

